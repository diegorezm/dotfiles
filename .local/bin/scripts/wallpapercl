#!/usr/bin/env bash

set -e

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/wallpaper"
CURRENT="$STATE_DIR/current"

mkdir -p "$STATE_DIR"

set_wallpaper() {
    local wallpaper="$1"

    # Resolve relative paths / ~ into an absolute path
    wallpaper="$(realpath "$wallpaper")"

    if [[ ! -f "$wallpaper" ]]; then
        echo "Wallpaper not found: $wallpaper" >&2
        exit 1
    fi

    pkill swaybg 2>/dev/null || true

    swaybg -i "$wallpaper" -m fill >/dev/null 2>&1 &

    printf '%s\n' "$wallpaper" > "$CURRENT"
}

case "${1:-}" in
    set)
        if [[ -z "${2:-}" ]]; then
            echo "Usage: wallpaper set <image>"
            exit 1
        fi

        set_wallpaper "$2"
        ;;

    restore)
        if [[ ! -f "$CURRENT" ]]; then
            echo "No wallpaper has been saved yet." >&2
            exit 1
        fi

        set_wallpaper "$(cat "$CURRENT")"
        ;;

    *)
        echo "Usage:"
        echo "  wallpaper set <image>"
        echo "  wallpaper restore"
        exit 1
        ;;
esac
