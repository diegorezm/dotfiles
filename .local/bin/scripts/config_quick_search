#!/bin/sh

choice=$(
	printf '%s\n' \
		'Noctalia' \
		'Alacritty' \
		'Neovim' \
		'Niri' \
		'Tmux' \
		'Shell scripts' \
		'Zsh' |
		noctalia dmenu -p 'Edit config'
) || exit 0

case "$choice" in
	Noctalia) target="$HOME/.config/noctalia" ;;
	Alacritty) target="$HOME/.config/alacritty/alacritty.toml" ;;
	Neovim) target="$HOME/.config/nvim" ;;
	Niri) target="$HOME/.config/niri/config.kdl" ;;
	Tmux) target="$HOME/.tmux.conf" ;;
	'Shell scripts') target="$HOME/.local/bin/scripts" ;;
	Zsh) target="$HOME/.zshrc" ;;
	*) exit 1 ;;
esac

[ -e "$target" ] || exit 1

working_directory=$target
[ -d "$working_directory" ] || working_directory=$(dirname "$working_directory")

case "${TERMINAL:-alacritty}" in
	*alacritty*) alacritty --working-directory "$working_directory" -e "${EDITOR:-nvim}" "$target" ;;
	*) "${TERMINAL:-alacritty}" -d "$working_directory" -e "${EDITOR:-nvim}" "$target" ;;
esac
